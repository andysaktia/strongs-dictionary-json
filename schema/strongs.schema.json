{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/REPLACE_ORG/strongs-dictionary-json/schema/strongs.schema.json",
  "title": "Strong's Dictionary Entry",
  "description": "Skema untuk satu entri Strong's Hebrew/Greek Dictionary dalam format JSON terstruktur (ID+EN).",
  "type": "object",
  "required": [
    "strong_number",
    "lemma",
    "language",
    "definition",
    "source",
    "translation_status"
  ],
  "properties": {
    "strong_number": {
      "type": "string",
      "pattern": "^[HG][0-9]{1,5}[a-z]?$",
      "description": "Nomor Strong, contoh: H430, G2316"
    },
    "lemma": {
      "type": "string",
      "description": "Kata asli dalam aksara Ibrani atau Yunani"
    },
    "transliteration": {
      "type": ["string", "null"],
      "description": "Transliterasi Latin dari lemma"
    },
    "pronunciation": {
      "type": ["string", "null"],
      "description": "Panduan pengucapan fonetik"
    },
    "language": {
      "type": "string",
      "enum": ["hebrew", "greek", "aramaic"]
    },
    "part_of_speech": {
      "type": ["string", "null"],
      "description": "Kelas kata, contoh: 'noun masculine plural'"
    },
    "definition": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": {
          "type": "string",
          "description": "Definisi asli berbahasa Inggris"
        },
        "id": {
          "type": ["string", "null"],
          "description": "Definisi berbahasa Indonesia (bisa null jika belum diterjemahkan)"
        }
      }
    },
    "kjv_translations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Daftar kata terjemahan dalam KJV yang menggunakan nomor Strong ini"
    },
    "root": {
      "type": ["string", "null"],
      "description": "Nomor Strong dari kata akar (root), jika ada"
    },
    "derivatives": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Daftar nomor Strong turunan dari kata ini"
    },
    "occurrences_count": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Jumlah kemunculan dalam teks Alkitab (jika tersedia dari sumber)"
    },
    "source": {
      "type": "string",
      "description": "Identifier sumber data mentah, contoh: 'openscriptures-strongs'"
    },
    "translation_status": {
      "type": "string",
      "enum": ["reviewed", "machine", "pending", "official-sabda"],
      "description": "Status kepercayaan terjemahan Indonesia"
    }
  },
  "additionalProperties": false
}
